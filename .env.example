# COMSOL MCP Server configuration
# Copy this file to .env and edit values for your system.

# COMSOL mphserver port (default: 2036)
COMSOL_PORT=2036

# Project base directory (default: this repo root)
# BASE_DIR=/path/to/your/project

# Path to COMSOL binary (platform-dependent)
# macOS:   /Applications/COMSOL64/Multiphysics/bin/comsol
# Linux:   /usr/local/comsol63/multiphysics/bin/comsol
# Windows: C:\Program Files\COMSOL\COMSOL64\Multiphysics\bin\comsol.exe
# COMSOL_BIN=/Applications/COMSOL64/Multiphysics/bin/comsol

# Model recipe file (generated by memorize_workflows.py)
# RECIPE_FILE=/path/to/comsol_recipes.json

# Knowledge base file (accumulated solver patterns)
# KB_FILE=/path/to/comsol_knowledge_base.json
